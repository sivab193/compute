.pi/

# Impeccable working files. The surface brief under .impeccable/surfaces/ is a
# committed design contract and is tracked; review captures and generated
# mockups are build artifacts and are not.
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/live/
.impeccable/questions/
